# 行末は LF をリポジトリ標準とする。
# core.autocrlf=true (Windows) と prettier (既定 endOfLine=lf) の衝突による
# 「LF will be replaced by CRLF」の幻影変更を抑止するため、.gitattributes で
# 強制的に LF を正とする（.gitattributes は個人の autocrlf より優先される）。
* text=auto eol=lf

# Windows 専用スクリプトは cmd.exe / レジストリ import の信頼性のため CRLF を維持。
*.bat text eol=crlf
*.cmd text eol=crlf
*.reg text eol=crlf

# --- deploy source export: 開発用リソースを git archive から除外（開発作業・checkout/clone には無影響）---
.claude/**                            export-ignore
.agents/**                            export-ignore
docs/**                               export-ignore
logs/**                               export-ignore
review-item-processor/fixtures/**     export-ignore
CLAUDE.md                             export-ignore
CONTEXT.md                            export-ignore
MyNeeds.md                            export-ignore
skills-lock.json                      export-ignore
touki-check-data.json                 export-ignore
